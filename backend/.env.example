# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Personal email address where contact form enquiries will be delivered
CONTACT_EMAIL=your-email@example.com

# Verified sender email configured in your Resend domain (e.g., Pixel Productions <contact@yourdomain.com>)
FROM_EMAIL=Pixel Productions <contact@yourdomain.com>

# Allowed frontend origin(s) for CORS (comma-separated, no trailing slash)
FRONTEND_URL=https://pixelproductions.netlify.app

# Server port (Render automatically injects PORT in production)
PORT=5000

# Optional rate limiting settings (defaults: 5 requests per 900 seconds / 15 minutes per IP)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=900
